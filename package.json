{
  "name": "testback",
  "private": true,
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "npm run dev --prefix server",
    "dev:web": "npm run dev --prefix web",
    "migrate": "npm run migrate:up --prefix server",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "oxfmt": "^0.73.0"
  }
}
